{
  "name": "mathflow",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "description": "MathFlow - Markdown 为主、LaTeX 为辅的新一代混合学术编辑器",
  "bin": {
    "mathflow": "./bin/mathflow.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "node bin/mathflow.mjs .",
    "serve": "node bin/mathflow.mjs",
    "export": "node bin/mathflow.mjs export",
    "engine": "node scripts/build-engine.mjs",
    "pack": "node scripts/pack.mjs",
    "exe": "node scripts/build-exe.mjs",
    "desktop": "electron .",
    "desktop:build": "node scripts/build-installer.mjs --only=setup",
    "desktop:pack": "node scripts/build-desktop.mjs",
    "icon": "node scripts/build-icon.mjs",
    "dist": "node scripts/build-installer.mjs",
    "dist:setup": "node scripts/build-installer.mjs --only=setup",
    "dist:portable": "node scripts/build-installer.mjs --only=portable"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "clsx": "^2.1.1",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "mathjs": "^13.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^2.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  },
  "main": "electron/main.cjs",
  "author": {
    "name": "MathFlow",
    "email": "mathflow@example.com"
  }
}
